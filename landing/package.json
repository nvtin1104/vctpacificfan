{
  "name": "valorant-pacific-fan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VCT Pacific 2027 Fan Hub — unofficial multi-page static esports portal (Astro SSG, relational JSON data, Cloudflare Pages)",
  "scripts": {
    "dev": "astro dev --host",
    "test": "node --test scripts/data.test.mjs scripts/bracket-layout.test.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "sync:teams": "node scripts/sync-liquipedia-teams.mjs",
    "db:query": "node scripts/db.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "deploy": "pnpm deploy:cf",
    "deploy:cf": "pnpm build && pnpm test:seo && npx --yes wrangler pages deploy dist --project-name vctpacificfan --branch main"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@lucide/astro": "1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "~5.9.3"
  }
}
