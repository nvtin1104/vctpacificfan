---
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MatchTicker from '../components/layout/MatchTicker.astro';
import { HTML_LANG, LOCALES, OG_LOCALE, loc, localePath, useT } from '../i18n';
import { CURRENT_SEASON, seasonBanner, seasonOfPath } from '../lib/data';
import { absolute, alternates, fileOg, generatedOg, ogImagePath, pageTitle, type OgImage, type PageMeta } from '../lib/seo';

type Props = PageMeta;
const { lang, path, title, description, ogImage, noindex = false, jsonLd = [] } = Astro.props;
const t = useT(lang);
const siteName = t('meta.siteName');
const fullTitle = pageTitle(title, siteName);
const canonical = absolute(Astro.site, localePath(lang, path));
// Default share image: the banner of the page's season (or the current one), else the generated default card.
const banner = seasonBanner(await seasonOfPath(path)) ?? seasonBanner(CURRENT_SEASON);
const og: OgImage =
  typeof ogImage === 'string' ? generatedOg(ogImage) : (ogImage ?? (banner ? fileOg(banner.image, loc(banner.alt, lang)) : generatedOg(ogImagePath('default'))));
const image = absolute(Astro.site, og.src);
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-spoilers="hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates(Astro.site, path).map(alt => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:type" content={og.type} />
    {og.alt && <meta property="og:image:alt" content={og.alt} />}
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LOCALES.filter(l => l !== lang).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {og.alt && <meta name="twitter:image:alt" content={og.alt} />}

    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Apply the stored spoiler preference before first paint so scores never flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('vct:spoilers') === 'shown') document.documentElement.dataset.spoilers = 'shown';
      } catch (e) {}
    </script>
    {jsonLd.map(data => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a href="#main" class="sr-only z-[60] bg-crimson px-4 py-2 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">{t('meta.skip')}</a>
    <div class="vt-header sticky top-0 z-40">
      <Header lang={lang} />
    </div>
    <MatchTicker lang={lang} />
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/runtime';
    </script>
  </body>
</html>
