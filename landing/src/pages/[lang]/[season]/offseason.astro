---
import TournamentCard from '../../../components/tournament/TournamentCard.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import SectionTitle from '../../../components/ui/SectionTitle.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useT, type Lang } from '../../../i18n';
import { seasonStaticPaths, tournamentsOf } from '../../../lib/data';
import { breadcrumbLd } from '../../../lib/jsonld';

export const getStaticPaths = () => seasonStaticPaths();
const lang = Astro.params.lang as Lang;
const year = Number(Astro.params.season);
const t = useT(lang, { year });
const events = (await tournamentsOf(year))
  .filter(x => x.data.kind === 'offseason')
  .sort((a, b) => (a.data.startDate ?? '9999').localeCompare(b.data.startDate ?? '9999'));
const path = `/${year}/offseason`;
---

<BaseLayout
  lang={lang}
  path={path}
  title={t('offseason.title')}
  description={t('offseason.lead')}
  jsonLd={[breadcrumbLd([{ name: t('nav.home'), path: '/' }, { name: t('ticker.offseason'), path }], Astro.site, lang)]}
>
  <div class="wrap py-10">
    <SectionTitle as="h1" eyebrow={t('ticker.offseason')} title={t('offseason.title')} lead={t('offseason.lead')} />

    {
      events.length ? (
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {events.map(ev => (
            <TournamentCard tournament={ev} lang={lang} />
          ))}
        </div>
      ) : (
        <EmptyState class="mt-8" text={t('offseason.empty')} />
      )
    }
  </div>
</BaseLayout>

