---
import { ArrowDown, ArrowRight, Check, User, UserX, X } from '@lucide/astro';
import ConfirmBadge from '../../../components/ui/ConfirmBadge.astro';
import SectionTitle from '../../../components/ui/SectionTitle.astro';
import Sources from '../../../components/ui/Sources.astro';
import TeamBadge from '../../../components/ui/TeamBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatMoney, loc, localePath, useT, type Lang } from '../../../i18n';
import { db, firstOfKind, seasonConfig, seasonPath, seasonStaticPaths, teamsOf } from '../../../lib/data';
import { breadcrumbLd } from '../../../lib/jsonld';

// Only seasons whose season.json sets "explainer": true have a format explainer (its copy lives in i18n rules.*).
export const getStaticPaths = () => seasonStaticPaths(s => s.explainer === true);
const lang = Astro.params.lang as Lang;
const year = Number(Astro.params.season);
const t = useT(lang, { year });
const season = seasonConfig(year);
const { tournament } = await db();
const partners = (await teamsOf(year)).filter(x => x.roster.data.status === 'partner').map(x => ({ ...x.team, data: { ...x.team.data, capsule: x.roster.data.capsule } }));
const cup = await firstOfKind(year, 'cup');
const path = seasonPath(year, 'rules');
const cupRegions = Object.entries(
  (cup?.data.slots ?? []).reduce<Record<string, number>>((acc, s) => ((acc[s.from?.id ?? 'tbd'] = (acc[s.from?.id ?? 'tbd'] ?? 0) + 1), acc), {}),
).map(([id, n]) => ({ event: tournament.get(id)!, n }));
const regionColor = ['#ff4655', '#f5b942', '#3ddbb0', '#7aa2ff', '#c084fc', '#f472b6', '#ece8e1'];
const stipendLabels = [t('rules.stipendKickoff'), t('rules.stipendMasters'), t('rules.stipendChampions')];
const maxSeason = season.stipends[0].amount * 3 + season.stipends[1].amount * 2 + season.stipends[2].amount;
---

<BaseLayout
  lang={lang}
  path={path}
  title={t('rules.title')}
  description={t('rules.lead')}
  jsonLd={[breadcrumbLd([{ name: t('nav.home'), path: '/' }, { name: t('nav.rules'), path }], Astro.site, lang)]}
>
  <div class="wrap py-10">
    <SectionTitle as="h1" eyebrow={t('nav.rules')} title={t('rules.title')} lead={t('rules.lead')} />

    <!-- 1. 8 Partners + 4 Open -->
    <section class="mt-12 space-y-6" aria-labelledby="model">
      <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
        <div>
          <h2 id="model" class="heading text-lg">{t('rules.modelTitle')}</h2>
          <p class="mt-2 text-sm text-muted">{t('rules.modelText')}</p>
        </div>
        <div class="panel p-6">
          <ul class="grid grid-cols-4 gap-2 sm:grid-cols-6" aria-label={t('rules.modelTitle')}>
            {
              partners.map(team => (
                <li>
                  <a href={localePath(lang, `/teams/${team.id}`)} class="flex flex-col items-center gap-1 bg-surface-2 p-2 text-center hover:bg-carbon" title={team.data.name}>
                    <TeamBadge team={team} />
                    <span class="text-[0.65rem] text-muted">Partner</span>
                  </a>
                </li>
              ))
            }
            {
              ['KR', 'JP', 'SEA', 'LCQ'].map(code => (
                <li class="flex flex-col items-center gap-1 border border-dashed border-crimson/50 p-2 text-center">
                  <TeamBadge fallback="?" />
                  <span class="text-[0.65rem] font-semibold text-crimson">Open · {code}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-4 flex items-center justify-center gap-3 text-lg font-semibold">
            <span>Kickoff · 12</span>
            <ArrowRight class="size-5 text-muted" aria-hidden="true" />
            <span class="text-crimson">Top 3 → Masters Seoul</span>
          </div>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-line bg-surface">
          <img
            src="/images/primer/kickoff-slots-2027.jpg"
            alt={t('rules.modelTitle')}
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
        <figure class="overflow-hidden rounded-lg border border-line bg-surface">
          <img
            src="/images/primer/roadshows-2027.jpg"
            alt="VCT Pacific 2027 Roadshows - Bangkok, Manila, Tokyo"
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
      </div>
    </section>

    <!-- 2. Partners can drop -->
    <section class="mt-14 space-y-6" aria-labelledby="partner">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
        <ol class="panel order-2 overflow-hidden lg:order-1">
          {
            ['Masters → Regional Playoffs (Top 4)', 'Regional Play-Ins (8 teams)', 'Open Qualifiers'].map((label, i) => (
              <li class:list={['flex items-center gap-4 px-5 py-4', i > 0 && 'border-t border-line']}>
                <span class:list={['grid size-7 place-items-center rounded-full text-xs font-bold', i === 0 ? 'bg-crimson text-white' : 'bg-surface-3 text-muted']}>{i + 1}</span>
                <span class="font-bold">{label}</span>
                {i < 2 && <ArrowDown class="ml-auto size-4 text-slate-muted" aria-hidden="true" />}
              </li>
            ))
          }
        </ol>
        <div class="order-1 lg:order-2">
          <h2 id="partner" class="heading text-lg">{t('rules.partnerTitle')}</h2>
          <p class="mt-2 text-sm text-muted">{t('rules.partnerText')}</p>
          <p class="mt-3 text-sm text-muted">{t('rules.partnerTerm')}</p>
        </div>
      </div>

      <figure class="overflow-hidden rounded-lg border border-line bg-surface">
        <img
          src="/images/primer/path-to-cups-2027.jpg"
          alt="Path to Cups from Open Qualifiers"
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </figure>
    </section>

    <!-- 3. Cup berths -->
    <section class="mt-14" aria-labelledby="cup">
      <h2 id="cup" class="heading text-lg">{t('rules.cupTitle')}</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted">{t('rules.cupText')}</p>
      <div class="mt-6 flex h-14 w-full overflow-hidden" role="img" aria-label={cupRegions.map(r => `${r.event.data.shortName} ${r.n}`).join(', ')}>
        {
          cupRegions.map((r, i) => (
            <span class="grid place-items-center border-r-2 border-carbon text-sm font-semibold text-carbon" style={`flex:${r.n};background:${regionColor[i % regionColor.length]}`}>
              {r.n}
            </span>
          ))
        }
      </div>
      <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          cupRegions.map((r, i) => (
            <li class="flex items-center gap-2">
              <span class="size-3" style={`background:${regionColor[i % regionColor.length]}`} aria-hidden="true" />
              <a href={localePath(lang, `/tournaments/${r.event.id}`)} class="hover:text-white">
                {r.event.data.shortName}
              </a>
              <span class="tabular-nums text-muted">×{r.n}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <figure class="overflow-hidden rounded-lg border border-line bg-surface">
          <img
            src="/images/primer/cup-slots-2027.jpg"
            alt={t('rules.cupTitle')}
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
        <figure class="overflow-hidden rounded-lg border border-line bg-surface">
          <img
            src="/images/primer/cup-lcq-2027.jpg"
            alt="Pacific Cup Last Chance Qualifier (LCQ)"
            width="1920"
            height="1080"
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
      </div>
    </section>

    <!-- 4. Roster continuity -->
    <section class="mt-14 grid gap-8 lg:grid-cols-2" aria-labelledby="continuity">
      <div>
        <h2 id="continuity" class="heading text-lg">{t('rules.continuityTitle')}</h2>
        <p class="mt-2 text-sm text-muted">{t('rules.continuityText')}</p>
        <p class="mt-3 text-sm text-muted">{t('rules.continuityNote')}</p>
      </div>
      <div class="grid gap-3">
        {
          [3, 2].map(kept => (
            <div class:list={['panel flex items-center justify-between gap-4 p-4', kept >= 3 ? 'border-teal/40' : 'border-crimson/40']}>
              <div class="flex gap-1.5" aria-label={`${kept}/5`}>
                {Array.from({ length: 5 }, (_, i) =>
                  i < kept ? <User class="size-7 text-bone" aria-hidden="true" /> : <UserX class="size-7 text-slate-muted" aria-hidden="true" />,
                )}
              </div>
              <span class:list={['flex items-center gap-1 font-bold', kept >= 3 ? 'text-teal' : 'text-crimson']}>
                {kept >= 3 ? <Check class="size-5" aria-hidden="true" /> : <X class="size-5" aria-hidden="true" />}
                {kept}/5 · {kept >= 3 ? t('rules.keep') : t('rules.lose')}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 5. Stipends -->
    <section class="mt-14" aria-labelledby="stipend">
      <h2 id="stipend" class="heading text-lg">{t('rules.stipendTitle')}</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted">{t('rules.stipendText')}</p>
      <div class="mt-6 grid gap-4 md:grid-cols-4">
        {
          season.stipends.map((s, i) => (
            <div class="panel p-5">
              <p class="text-sm text-muted">{stipendLabels[i]}</p>
              <p class="mt-2 text-3xl font-bold text-crimson">{formatMoney(s.amount, lang)}</p>
            </div>
          ))
        }
        <div class="bg-crimson p-5 text-white">
          <p class="text-sm opacity-80">Kickoff + Cup 1 + Cup 2 + 2× Masters + Champions</p>
          <p class="mt-2 text-3xl font-bold">{formatMoney(maxSeason, lang)}</p>
        </div>
      </div>
    </section>

    <!-- 6. Skirmish -->
    <section class="mt-14" aria-labelledby="skirmish">
      <h2 id="skirmish" class="heading text-lg">{t('rules.skirmishTitle')}</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted">{t('rules.skirmishText')}</p>
      <ol class="mt-6 grid gap-3 md:grid-cols-3">
        {
          [t('rules.skirmishStep1'), t('rules.skirmishStep2'), t('rules.skirmishStep3')].map((step, i) => (
            <li class="panel flex items-center gap-4 p-5">
              <span class="text-3xl font-bold text-crimson">{i + 1}</span>
              <span class="font-semibold text-lg ">{step}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 7. Map pool + capsules -->
    <section class="mt-14 grid gap-8 lg:grid-cols-2" aria-labelledby="capsules">
      <div>
        <h2 id="capsules" class="heading flex items-center gap-3 text-lg">{t('rules.capsuleTitle')}</h2>
        <p class="mt-2 text-sm text-muted">{t('rules.capsuleText')}</p>
        <ul class="mt-6 grid grid-cols-4 gap-2">
          {
            partners.map(team => (
              <li class="flex flex-col items-center gap-1 border border-line p-3 text-center">
                <TeamBadge team={team} />
                <span class="text-[0.65rem] uppercase text-muted">{team.data.capsule.name ?? t('common.tba')}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="heading flex flex-wrap items-center gap-3 text-lg">{t('match.mapPool')} <ConfirmBadge confirmed={season.mapPool.confirmed} lang={lang} /></h2>
        <p class="mt-2 text-sm text-muted">{loc(season.mapPool.note, lang)}</p>
        <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            season.mapPool.maps.map(map => (
              <li class="bg-surface px-4 py-3 font-semibold text-xl ">
                {map}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <p class="mt-16 text-sm text-muted">{t('rules.unconfirmedNote')}</p>
    <Sources sources={[...season.sources, season.mapPool.source]} lang={lang} />
  </div>
</BaseLayout>
