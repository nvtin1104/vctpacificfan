---
import { ArrowRight, CalendarDays, MapPin, Trophy, Users } from '@lucide/astro';
import Bracket from '../../../components/tournament/Bracket.astro';
import ConfirmBadge from '../../../components/ui/ConfirmBadge.astro';
import EmptyState from '../../../components/ui/EmptyState.astro';
import Sources from '../../../components/ui/Sources.astro';
import StatusPill from '../../../components/ui/StatusPill.astro';
import TeamBadge from '../../../components/ui/TeamBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDateRange, formatMoney, LOCALES, loc, localePath, useT, type Lang } from '../../../i18n';
import { countryName, db, feedersOf, refId, regionName, seasonConfig, sectionPath } from '../../../lib/data';
import { breadcrumbLd, tournamentLd } from '../../../lib/jsonld';
import { ogImagePath, truncateDescription } from '../../../lib/seo';

export async function getStaticPaths() {
  const { tournaments } = await db();
  return LOCALES.flatMap(lang => tournaments.map(x => ({ params: { lang, slug: x.id } })));
}

const lang = Astro.params.lang as Lang;
const { tournament, team: teams, matches, bracketFor } = await db();
const event = tournament.get(Astro.params.slug!)!;
const d = event.data;
const t = useT(lang, { year: d.season });
const eventMatches = matches.filter(m => refId(m.data.tournament) === event.id);
const bracket = bracketFor.get(event.id);
const feeders = await feedersOf(event.id);
const dates = formatDateRange(d.startDate, d.endDate, lang);
const place = d.location ? `${loc(d.location.city, lang)}, ${countryName(d.location.country, lang)}` : regionName(d.region, lang);
// Fixed payment for open teams, by event kind, from that season's config.
const stipends = seasonConfig(d.season).stipends;
const stipendFor = { kickoff: 'kickoff-cup', cup: 'kickoff-cup', masters: 'masters', champions: 'champions' } as Record<string, string>;
const stipend = stipends.find(x => x.stage === stipendFor[d.kind])?.amount ?? null;
const primerGraphicByKind: Record<string, string> = {
  kickoff: '/images/primer/kickoff-slots-2027.jpg',
  'kickoff-qualifier': '/images/primer/kickoff-slots-2027.jpg',
  cup: '/images/primer/cup-slots-2027.jpg',
  lcq: '/images/primer/cup-lcq-2027.jpg',
  regional: '/images/primer/path-to-cups-2027.jpg',
  'wild-card': '/images/primer/path-to-cups-2027.jpg',
  masters: '/images/primer/roadmap-2027.jpg',
  champions: '/images/primer/roadmap-2027.jpg',
};
const primerGraphic = d.season === 2027 ? primerGraphicByKind[d.kind] : undefined;
const metaTitle = d.name.length <= 38 ? t('seo.tournamentTitle', { name: d.name }) : d.name;
const description = truncateDescription(`${loc(d.description, lang)} ${loc(d.format.summary, lang)}`, 160);
const crumbs = [
  { name: t('nav.home'), path: '/' },
  { name: t('nav.tournaments'), path: sectionPath(d.season, 'tournaments') },
  { name: d.shortName, path: `/tournaments/${event.id}` },
];
---

<BaseLayout
  lang={lang}
  path={`/tournaments/${event.id}`}
  title={metaTitle}
  description={description}
  ogImage={ogImagePath('tournament', event.id)}
  ogImageAlt={d.name}
  jsonLd={[tournamentLd(event, eventMatches, teams, Astro.site, lang), breadcrumbLd(crumbs, Astro.site, lang)]}
>
  <section class="border-b border-line">
    <div class="wrap py-12 md:py-16">
      <nav class="mb-6 tabular-nums text-xs uppercase text-muted" aria-label="Breadcrumb">
        <a href={localePath(lang)} class="hover:text-white">{t('nav.home')}</a>
        <span aria-hidden="true"> / </span>
        <a href={localePath(lang, sectionPath(d.season, 'tournaments'))} class="hover:text-white">{t('nav.tournaments')} {d.season}</a>
        <span aria-hidden="true"> / </span>
        <span>{t(`tier.${d.tier}`)}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip chip-red">{t(`tier.${d.tier}long`)}</span>
        <StatusPill status={d.status} lang={lang} />
      </div>
      <h1 class="heading mt-4 text-3xl md:text-[2.5rem]">{d.name}</h1>
      <p class="mt-4 max-w-3xl text-lg text-muted">{loc(d.description, lang)}</p>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="panel p-4">
          <dt class="flex items-center gap-2 tabular-nums text-[0.7rem] uppercase text-muted"><CalendarDays class="size-4 text-muted" aria-hidden="true" />{t('common.dates')}</dt>
          <dd class="mt-2 flex flex-wrap items-center gap-2 font-semibold text-lg ">{dates ?? t('common.tba')} <ConfirmBadge confirmed={d.datesConfirmed} lang={lang} /></dd>
        </div>
        <div class="panel p-4">
          <dt class="flex items-center gap-2 tabular-nums text-[0.7rem] uppercase text-muted"><MapPin class="size-4 text-muted" aria-hidden="true" />{t('common.location')}</dt>
          <dd class="mt-2 font-semibold text-lg ">{place}</dd>
        </div>
        <div class="panel p-4">
          <dt class="flex items-center gap-2 tabular-nums text-[0.7rem] uppercase text-muted"><Users class="size-4 text-muted" aria-hidden="true" />{t('common.teams')}</dt>
          <dd class="mt-2 font-semibold text-lg ">{d.format.teams ?? t('common.tba')}</dd>
        </div>
        <div class="panel p-4">
          <dt class="flex items-center gap-2 tabular-nums text-[0.7rem] uppercase text-muted"><Trophy class="size-4 text-muted" aria-hidden="true" />{t('common.prizePool')}</dt>
          <dd class="mt-2 font-semibold text-lg ">{d.prizePool ? formatMoney(d.prizePool, lang) : t('tournaments.prizeTba')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <div class="wrap grid gap-12 py-12 lg:grid-cols-[2fr_1fr]">
    <section aria-labelledby="format">
      <h2 id="format" class="heading flex items-center gap-3 text-xl">{t('common.format')} <ConfirmBadge confirmed={d.format.confirmed} lang={lang} /></h2>
      <p class="mt-3 text-muted">{loc(d.format.summary, lang)}</p>
      {stipend && <p class="mt-3 text-sm text-teal">{t('tournaments.stipendNote', { amount: formatMoney(stipend, lang) })}</p>}
      {
        primerGraphic && (
          <figure class="mt-6 overflow-hidden rounded-lg border border-line bg-surface">
            <img
              src={primerGraphic}
              alt={`${d.name} - ${t('common.format')}`}
              width="1920"
              height="1080"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </figure>
        )
      }
    </section>

    <aside class="space-y-6">
      {
        d.qualifiesTo.length > 0 && (
          <div>
            <h2 class="eyebrow mb-3">{t('tournaments.qualifiesTo')}</h2>
            <ul class="space-y-2">
              {d.qualifiesTo.map(q => {
                const target = tournament.get(refId(q.tournament)!)!;
                return (
                  <li>
                    <a href={localePath(lang, `/tournaments/${target.id}`)} class="panel flex items-center justify-between gap-3 p-3">
                      <span>
                        <span class="block font-semibold">{target.data.name}</span>
                        <span class="block text-xs text-muted">{q.spots ? t('tournaments.spots', { n: q.spots }) : loc(q.note, lang)}</span>
                      </span>
                      <ArrowRight class="size-4 text-muted" aria-hidden="true" />
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }
      {
        feeders.length > 0 && (
          <div>
            <h2 class="eyebrow mb-3">{t('tournaments.fedBy')}</h2>
            <ul class="flex flex-wrap gap-2">
              {feeders.map(f => (
                <li>
                  <a href={localePath(lang, `/tournaments/${f.id}`)} class="chip hover:text-bone">
                    {f.data.shortName}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>

  {
    d.slots.length > 0 && (
      <section class="wrap py-4" aria-labelledby="slots">
        <h2 id="slots" class="heading mb-6 text-xl">{t('tournaments.slots')}</h2>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {d.slots.map(slot => {
            const team = slot.team ? teams.get(slot.team.id) : undefined;
            const from = slot.from ? tournament.get(slot.from.id) : undefined;
            const href = team ? localePath(lang, `/teams/${team.id}`) : from ? localePath(lang, `/tournaments/${from.id}`) : undefined;
            const inner = (
              <>
                <TeamBadge team={team} fallback="?" />
                <span class="min-w-0">
                  <span class:list={['block truncate', team && 'font-semibold']}>{team ? team.data.name : loc(slot.label, lang)}</span>
                  <span class="block truncate text-xs text-muted">{team ? loc(slot.label, lang) : from ? t('tournaments.fromEvent', { event: from.data.shortName }) : t('common.tbd')}</span>
                </span>
              </>
            );
            return (
              <li>
                {href ? (
                  <a href={href} class:list={['flex h-full items-center gap-3 p-3', team ? 'panel' : 'border border-dashed border-line text-muted']}>
                    {inner}
                  </a>
                ) : (
                  <div class:list={['flex h-full items-center gap-3 p-3', team ? 'panel' : 'border border-dashed border-line text-muted']}>
                    {inner}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section class="wrap py-12" aria-labelledby="bracket">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <h2 id="bracket" class="heading text-xl">{t('tournaments.bracket')}</h2>
      {bracket && <ConfirmBadge confirmed={bracket.data.confirmed} lang={lang} />}
    </div>
    {
      bracket ? (
        <>
          <p class="mb-8 max-w-3xl text-sm text-muted">{loc(bracket.data.note, lang)}</p>
          <Bracket bracket={bracket} lang={lang} />
        </>
      ) : (
        <EmptyState text={t('tournaments.noBracket')} />
      )
    }
    {
      eventMatches.length > 0 && (
        <a href={`${localePath(lang, sectionPath(d.season, 'schedule'))}?tournament=${event.id}`} class="btn btn-ghost mt-8">
          {t('tournaments.matches')} ({eventMatches.length}) <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      )
    }
    <Sources sources={d.sources} lang={lang} />
  </section>
</BaseLayout>
