---
import { Globe } from '@lucide/astro';
import { LANG_LABEL, LOCALES, localePath, stripLang, useT, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  /** Optional explicit language-less path; defaults to the current URL. */
  path?: string;
  id: string;
}
const { lang, id } = Astro.props;
const path = Astro.props.path ?? stripLang(Astro.url.pathname);
const t = useT(lang);
---

<div class="relative" data-mega>
  <button
    type="button"
    class="flex items-center gap-1.5 px-2 py-2 tabular-nums text-xs uppercase text-muted hover:text-bone"
    aria-expanded="false"
    aria-controls={id}
    aria-label={t('nav.language')}
    data-mega-trigger
  >
    <Globe class="size-4" aria-hidden="true" />
    {lang}
  </button>
  <ul id={id} hidden class="panel absolute right-0 top-full z-50 mt-2 w-44 py-1">
    {
      LOCALES.map(code => (
        <li>
          <a
            href={localePath(code, path)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? 'true' : undefined}
            class:list={['flex items-center justify-between px-4 py-2 text-sm hover:bg-surface-3', code === lang ? 'text-crimson' : 'text-bone']}
          >
            {LANG_LABEL[code]}
            <span class="tabular-nums text-[0.65rem] uppercase text-muted">{code}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
