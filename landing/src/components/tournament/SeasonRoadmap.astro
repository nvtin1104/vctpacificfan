---
import { ArrowDown } from '@lucide/astro';
import { formatDateRange, loc, localePath, useT, type Lang } from '../../i18n';
import { CURRENT_SEASON, db, refId, regionName, tournamentsOf, type Tournament } from '../../lib/data';

interface Props {
  lang: Lang;
  year?: number;
}
const { lang, year = CURRENT_SEASON } = Astro.props;
const t = useT(lang, { year });
const { tournament } = await db();

// Exclude offseason events (e.g. Red Bull Home Ground, Predator League) from the official season roadmap.
const circuit = (await tournamentsOf(year)).filter(x => x.data.kind !== 'offseason');

const byDate = (a: Tournament, b: Tournament) =>
  (a.data.startDate ?? '9999').localeCompare(b.data.startDate ?? '9999') || a.data.tier - b.data.tier;

const kickoffQualifiers = circuit.filter(x => x.data.kind === 'kickoff-qualifier').sort(byDate);
const kickoffs = circuit.filter(x => x.data.kind === 'kickoff').sort(byDate);
const firstCupStart =
  circuit
    .filter(x => x.data.kind === 'cup' && x.data.startDate)
    .sort(byDate)[0]?.data.startDate ?? '9999';
const earlyIntl = circuit
  .filter(x => (x.data.kind === 'masters' || x.data.kind === 'champions') && (x.data.startDate ?? '9999') < firstCupStart)
  .sort(byDate);
const regionals = circuit.filter(x => x.data.kind === 'regional' || x.data.kind === 'wild-card');
const lcqs = circuit.filter(x => x.data.kind === 'lcq').sort(byDate);
const lateEvents = circuit
  .filter(
    x =>
      (x.data.kind === 'cup' || x.data.kind === 'masters' || x.data.kind === 'champions') &&
      (x.data.startDate ?? '9999') >= firstCupStart,
  )
  .sort(byDate);

// Group late events that share the exact same timeline window into a single tree level.
const lateGroups: Tournament[][] = [];
for (const ev of lateEvents) {
  const prev = lateGroups.at(-1);
  if (prev && prev[0].data.startDate && prev[0].data.startDate === ev.data.startDate) {
    prev.push(ev);
  } else {
    lateGroups.push([ev]);
  }
}

const levels: Tournament[][] = [
  ...(kickoffQualifiers.length ? [kickoffQualifiers] : []),
  ...(kickoffs.length ? [kickoffs] : []),
  ...(earlyIntl.length ? [earlyIntl] : []),
  ...(regionals.length ? [regionals] : []),
  ...(lcqs.length ? [lcqs] : []),
  ...lateGroups,
];

const tierChipClass = (tier: 1 | 2 | 3) =>
  tier === 1 ? 'chip-red' : tier === 2 ? 'chip-amber' : '';
---

<div class="relative" data-roadmap>
  <ol class="relative space-y-0">
    {
      levels.map((group, idx) => {
        const isMulti = group.length > 1;
        const first = group[0];
        const groupDates =
          !isMulti && first.data.startDate
            ? formatDateRange(first.data.startDate, first.data.endDate, lang)
            : isMulti && group.every(g => g.data.startDate === first.data.startDate && first.data.startDate)
              ? formatDateRange(first.data.startDate, first.data.endDate, lang)
              : null;

        return (
          <li class="relative pl-7 md:pl-9">
            {/* Vertical tree trunk line */}
            {idx < levels.length - 1 && (
              <span
                class="pointer-events-none absolute bottom-0 left-[0.5625rem] top-3 w-0.5 bg-line-strong md:left-[0.6875rem]"
                aria-hidden="true"
              />
            )}

            {/* Tree node dot on the trunk */}
            <span
              class:list={[
                ' absolute left-0 top-3.5 grid size-5 place-items-center rounded-full border-2 bg-carbon md:left-0.5',
                first.data.tier === 1
                  ? 'border-crimson'
                  : first.data.tier === 2
                    ? 'border-amber'
                    : 'border-line-strong',
              ]}
              aria-hidden="true"
            >
              <span
                class:list={[
                  'size-2 rounded-full',
                  first.data.tier === 1
                    ? 'bg-crimson'
                    : first.data.tier === 2
                      ? 'bg-amber'
                      : 'bg-muted',
                ]}
              />
            </span>

            {/* Horizontal branch connector from trunk to card/group */}
            <span
              class="pointer-events-none absolute left-5 top-[1.375rem] h-0.5 w-2 bg-line-strong md:left-5.5 md:w-3.5"
              aria-hidden="true"
            />

            <div class="pb-5">
              {isMulti ? (
                <div class="rounded-lg border border-line bg-surface/60 p-3.5 md:p-4">
                  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class:list={['chip text-[0.6875rem]', tierChipClass(first.data.tier)]}>
                        {t(`tier.${first.data.tier}`)}
                      </span>
                      <span class="text-xs font-bold uppercase tracking-wider text-muted">
                        {t(`tier.${first.data.tier}long`)} ({group.length})
                      </span>
                    </div>
                    <span class="text-xs font-semibold text-muted">{groupDates ?? t('common.tba')}</span>
                  </div>

                  <ul class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
                    {group.map(x => {
                      const targets = x.data.qualifiesTo.map(q => refId(q.tournament)!);
                      const dates = formatDateRange(x.data.startDate, x.data.endDate, lang);
                      return (
                        <li>
                          <a
                            href={localePath(lang, `/tournaments/${x.id}`)}
                            data-node={x.id}
                            data-targets={targets.join(' ')}
                            class="roadmap-node flex h-full flex-col justify-between rounded border border-line bg-surface-2 px-3.5 py-3"
                          >
                            <div>
                              <span class="flex items-baseline justify-between gap-2">
                                <span class="text-sm font-bold text-bone">{x.data.shortName}</span>
                                <span class="text-[0.6875rem] font-semibold uppercase text-muted">
                                  {x.data.location ? loc(x.data.location.city, lang) : regionName(x.data.region, lang)}
                                </span>
                              </span>
                              {dates && <span class="mt-1 block text-xs text-muted">{dates}</span>}
                            </div>
                            {targets.length > 0 && (
                              <span class="mt-2.5 flex flex-wrap gap-1">
                                {x.data.qualifiesTo.map(q => (
                                  <span class="chip text-[0.6875rem]">
                                    → {tournament.get(refId(q.tournament)!)?.data.shortName}
                                    {q.spots ? ` ×${q.spots}` : ''}
                                  </span>
                                ))}
                              </span>
                            )}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ) : (
                group.map(x => {
                  const targets = x.data.qualifiesTo.map(q => refId(q.tournament)!);
                  const dates = formatDateRange(x.data.startDate, x.data.endDate, lang);
                  return (
                    <a
                      href={localePath(lang, `/tournaments/${x.id}`)}
                      data-node={x.id}
                      data-targets={targets.join(' ')}
                      class="roadmap-node block rounded-lg border border-line bg-surface-2 px-4 py-3.5 md:px-5"
                    >
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap items-center gap-2.5">
                          <span class:list={['chip text-[0.6875rem]', tierChipClass(x.data.tier)]}>
                            {t(`tier.${x.data.tier}`)}
                          </span>
                          <span class="text-sm font-bold text-bone md:text-base">{x.data.name}</span>
                        </div>
                        <span class="text-xs font-semibold text-muted">
                          {dates ?? t('common.tba')}
                          {x.data.location ? ` · ${loc(x.data.location.city, lang)}` : ` · ${regionName(x.data.region, lang)}`}
                        </span>
                      </div>
                      {targets.length > 0 && (
                        <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
                          {x.data.qualifiesTo.map(q => (
                            <span class="chip text-[0.6875rem]">
                              → {tournament.get(refId(q.tournament)!)?.data.shortName}
                              {q.spots ? ` ×${q.spots}` : ''}
                            </span>
                          ))}
                        </div>
                      )}
                    </a>
                  );
                })
              )}

              {idx < levels.length - 1 && (
                <div class="mt-2 flex items-center gap-1.5 pl-2 text-xs text-muted" aria-hidden="true">
                  <ArrowDown class="size-3.5 text-crimson/80" />
                </div>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .roadmap-node {
    transition:
      border-color 120ms,
      background-color 120ms,
      opacity 120ms;
  }
  [data-roadmap].is-focused .roadmap-node:not(.is-lit) {
    opacity: 0.4;
  }
  .roadmap-node.is-lit {
    border-color: var(--color-crimson);
    background-color: var(--color-surface-3);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-roadmap]')) {
    const nodes = new Map([...root.querySelectorAll<HTMLElement>('[data-node]')].map(el => [el.dataset.node!, el]));

    function light(id: string | null) {
      root.classList.toggle('is-focused', !!id);
      const lit = new Set<string>();
      if (id) {
        lit.add(id);
        for (const target of nodes.get(id)?.dataset.targets?.split(' ').filter(Boolean) ?? []) lit.add(target);
        for (const [other, el] of nodes) {
          if (el.dataset.targets?.split(' ').filter(Boolean).includes(id)) lit.add(other);
        }
      }
      for (const [nid, el] of nodes) el.classList.toggle('is-lit', lit.has(nid));
    }

    for (const [id, el] of nodes) {
      el.addEventListener('pointerenter', () => light(id));
      el.addEventListener('focus', () => light(id));
      el.addEventListener('pointerleave', () => light(null));
      el.addEventListener('blur', () => light(null));
    }
  }
</script>
