---
import { ExternalLink } from '@lucide/astro';
import { useT, type Lang } from '../../i18n';

interface Props {
  sources: { label: string; url: string }[];
  lang: Lang;
}
const { sources, lang } = Astro.props;
const t = useT(lang);
---

{
  sources.length > 0 && (
    <details class="mt-8 border-t border-line pt-4 text-sm text-muted">
      <summary class="cursor-pointer tabular-nums text-xs uppercase">{t('common.sources')}</summary>
      <ul class="mt-3 space-y-1.5">
        {sources.map(s => (
          <li>
            <a class="link inline-flex items-center gap-1" href={s.url} rel="noopener noreferrer external" target="_blank">
              {s.label}
              <ExternalLink class="size-3" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
