---
import { HTML_LANG, type Lang } from '../../i18n';

interface Props {
  iso: string;
  lang: Lang;
  mode?: 'datetime' | 'time' | 'date';
  class?: string;
}
const { iso, lang, mode = 'datetime', class: className } = Astro.props;
// Build-time fallback in UTC; the client script rewrites it in the viewer's own time zone.
const options: Intl.DateTimeFormatOptions =
  mode === 'time'
    ? { hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' }
    : mode === 'date'
      ? { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }
      : { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' };
const fallback = new Intl.DateTimeFormat(HTML_LANG[lang], options).format(new Date(iso));
---

<time datetime={iso} data-local-time={mode} class={className}>{fallback}</time>
