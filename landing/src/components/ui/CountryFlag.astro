---
interface Props {
  code?: string | null;
  class?: string;
}
const { code, class: className = '' } = Astro.props;
const c = code?.toUpperCase() ?? '';
const emoji = /^[A-Z]{2}$/.test(c) ? [...c].map(ch => String.fromCodePoint(0x1f1e6 + ch.charCodeAt(0) - 65)).join('') : '';
---

{
  c && (
    <span class:list={['inline-flex shrink-0 items-center', className]} aria-hidden="true">
      {c === 'KR' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#fff" />
          <circle cx="12" cy="8" r="3.6" fill="#cd2e3a" />
          <path d="M12 8a1.8 1.8 0 0 1-3.6 0 3.6 3.6 0 0 0 7.2 0A1.8 1.8 0 0 1 12 8Z" fill="#0047a0" />
          <path stroke="#111" stroke-width="0.9" d="M4.2 4.2l2.4-1.6M4.8 5.2l2.4-1.6M5.4 6.2l2.4-1.6M16.2 2.6l2.4 1.6M15.6 3.6l2.4 1.6M15 4.6l2.4 1.6M4.2 11.8l2.4 1.6M4.8 10.8l2.4 1.6M5.4 9.8l2.4 1.6M16.2 13.4l2.4-1.6M15.6 12.4l2.4-1.6M15 11.4l2.4-1.6" />
        </svg>
      ) : c === 'US' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#b22234" />
          <path stroke="#fff" stroke-width="1.23" d="M0 1.85h24M0 4.31h24M0 6.77h24M0 9.23h24M0 11.69h24M0 14.15h24" />
          <rect width="10" height="8.6" fill="#3c3b6e" />
        </svg>
      ) : c === 'CA' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#fff" />
          <rect width="6" height="16" fill="#d80621" />
          <rect x="18" width="6" height="16" fill="#d80621" />
          <path fill="#d80621" d="M12 3l1 2.5 2-.5-.8 2.2 1.8 1-1.5 1.3.3 1.5-2.3-.4v2.4h-1v-2.4l-2.3.4.3-1.5L8 8.2l1.8-1L9 5l2 .5Z" />
        </svg>
      ) : c === 'VN' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#da251d" />
          <polygon fill="#ff0" points="12,3.2 13.2,6.8 17,6.8 13.9,9 15.1,12.6 12,10.4 8.9,12.6 10.1,9 7,6.8 10.8,6.8" />
        </svg>
      ) : c === 'JP' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#fff" />
          <circle cx="12" cy="8" r="4.5" fill="#bc002d" />
        </svg>
      ) : c === 'SG' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="8" fill="#ef3340" />
          <rect y="8" width="24" height="8" fill="#fff" />
          <circle cx="6.2" cy="4" r="2.6" fill="#fff" />
          <circle cx="7.2" cy="4" r="2.1" fill="#ef3340" />
        </svg>
      ) : c === 'ID' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="8" fill="#ce1126" />
          <rect y="8" width="24" height="8" fill="#fff" />
        </svg>
      ) : c === 'TH' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#a51931" />
          <rect y="2.7" width="24" height="10.6" fill="#f4f5f8" />
          <rect y="5.3" width="24" height="5.4" fill="#2d2a4a" />
        </svg>
      ) : c === 'PH' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="8" fill="#0038a8" />
          <rect y="8" width="24" height="8" fill="#ce1126" />
          <polygon points="0,0 11,8 0,16" fill="#fff" />
          <circle cx="4" cy="8" r="1.8" fill="#fcd116" />
        </svg>
      ) : c === 'MY' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#cc0001" />
          <path stroke="#fff" stroke-width="1.2" d="M0 1.8h24M0 4.2h24M0 6.6h24M0 9h24M0 11.4h24M0 13.8h24" />
          <rect width="11" height="8.5" fill="#010066" />
          <circle cx="5.2" cy="4.2" r="2.2" fill="#ffcc00" />
          <circle cx="6.1" cy="4.2" r="1.8" fill="#010066" />
        </svg>
      ) : c === 'AU' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#00008b" />
          <rect width="10" height="8" fill="#012169" />
          <path stroke="#fff" stroke-width="1.6" d="M5 0v8M0 4h10" />
          <path stroke="#c8102e" stroke-width="0.9" d="M5 0v8M0 4h10" />
          <circle cx="5" cy="12" r="1.3" fill="#fff" />
          <circle cx="18" cy="4" r="1" fill="#fff" />
          <circle cx="19" cy="9" r="1" fill="#fff" />
          <circle cx="16" cy="11" r="1" fill="#fff" />
        </svg>
      ) : c === 'ES' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="16" fill="#aa151b" />
          <rect y="4" width="24" height="8" fill="#f1bf00" />
        </svg>
      ) : c === 'RU' ? (
        <svg viewBox="0 0 24 16" class="h-3.5 w-5 rounded-[2px] border border-white/15">
          <rect width="24" height="5.33" fill="#fff" />
          <rect y="5.33" width="24" height="5.34" fill="#0039a6" />
          <rect y="10.67" width="24" height="5.33" fill="#d52b1e" />
        </svg>
      ) : (
        <span class="text-sm leading-none">{emoji || c}</span>
      )}
    </span>
  )
}

