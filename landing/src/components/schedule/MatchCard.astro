---
import { loc, localePath, useT, type Lang } from '../../i18n';
import { db, refId, sideName, teamIds, type Match } from '../../lib/data';
import LocalTime from '../ui/LocalTime.astro';
import TeamBadge from '../ui/TeamBadge.astro';

interface Props {
  match: Match;
  lang: Lang;
  /** Hide the tournament name when the surrounding page already names it. */
  showTournament?: boolean;
}
const { match: m, lang, showTournament = true } = Astro.props;
const t = useT(lang);
const { tournament, team: teams } = await db();
const event = tournament.get(refId(m.data.tournament)!)!;
const month = (m.data.startTime ?? event.data.startDate ?? '').slice(0, 7);
const [a, b] = m.data.teams;
const teamOf = (side: typeof a) => (side.team ? teams.get(side.team.id) : undefined);
const hasScore = a.score !== null && b.score !== null;
---

<li data-match-card data-tier={event.data.tier} data-kind={event.data.kind} data-tournament={event.id} data-teams={teamIds(m).join(' ')} data-status={m.data.status} data-month={month}>
  <a href={localePath(lang, `/matches/${m.id}`)} class="panel-item block px-4 py-3">
    <div class="grid grid-cols-[5.5rem_1fr] items-center gap-2 sm:grid-cols-[6.5rem_1fr_6.5rem]">
      <span class="text-sm font-bold tabular-nums">
        {
          m.data.status === 'live' ? (
            <span class="inline-flex items-center gap-1.5 text-crimson">
              <span class="live-dot" />
              {t('status.live')}
            </span>
          ) : m.data.startTime ? (
            <LocalTime iso={m.data.startTime} lang={lang} mode="time" />
          ) : (
            <span class="whitespace-nowrap text-xs text-muted">{t('common.tba')}</span>
          )
        }
      </span>
      <span class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-sm">
        <span class:list={['flex min-w-0 items-center justify-end gap-2 text-right', m.data.winner === 1 && 'opacity-60']}>
          <span class:list={['truncate', teamOf(a) ? 'font-bold' : 'text-muted']}>{sideName(a, teams, lang)}</span>
          {teamOf(a) && <TeamBadge team={teamOf(a)} size="sm" />}
        </span>
        {
          hasScore ? (
            <span class="font-bold tabular-nums" data-score>
              {a.score} - {b.score}
            </span>
          ) : (
            <span class="text-slate-muted">/</span>
          )
        }
        <span class:list={['flex min-w-0 items-center gap-2', m.data.winner === 0 && 'opacity-60']}>
          {teamOf(b) && <TeamBadge team={teamOf(b)} size="sm" />}
          <span class:list={['truncate', teamOf(b) ? 'font-bold' : 'text-muted']}>{sideName(b, teams, lang)}</span>
        </span>
      </span>
      <span class="hidden text-right text-xs font-bold sm:block">{m.data.format.toUpperCase()}</span>
    </div>
    <div class="mt-2.5 flex items-center justify-between gap-3 text-xs text-steel">
      <span class="truncate">
        {showTournament && <>{event.data.shortName} • </>}
        {loc(m.data.stage, lang)}
      </span>
      <span class="font-bold text-bone sm:hidden">{m.data.format.toUpperCase()}</span>
    </div>
  </a>
</li>
